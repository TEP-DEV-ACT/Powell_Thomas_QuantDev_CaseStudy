# Postgres connection used by the Flask app and ingestion scripts.
# When running via docker compose, host "db" resolves to the postgres service.
DATABASE_URL=postgresql://tracker:tracker@localhost:5432/tracker

# Anthropic API — model/base URL are env-driven so graders can point at their own proxy.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5

# SEC EDGAR requires a descriptive User-Agent with real contact info (fair access policy).
SEC_USER_AGENT=Thomas Powell thomaspowellhhe@outlook.com

# Optional — FRED API key. If unset, ingestion falls back to the keyless fredgraph.csv endpoint.
FRED_API_KEY=

FLASK_PORT=8000
